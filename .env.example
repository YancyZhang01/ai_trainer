# 所有支持 OpenAI-compatible API 的模型统一使用以下三个变量。
LLM_API_KEY=your_api_key
LLM_MODEL_NAME=your_model_or_endpoint_id
LLM_BASE_URL=https://your-provider.example.com/v1
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
LLM_CLIENT_MAX_RETRIES=0
LLM_RETRY_MAX=3
LLM_RETRY_DELAY_SECONDS=2
RAGAS_METRIC_TIMEOUT_SECONDS=120

# 可选：为自动评测使用独立且更快的 Judge 模型；不设置则复用 LLM_*。
# RAGAS_API_KEY=your_judge_api_key
# RAGAS_MODEL_NAME=your_fast_judge_model_or_endpoint_id
# RAGAS_BASE_URL=https://your-provider.example.com/v1

# 现有豆包配置也继续兼容：
# DOUBAO_API_KEY=your_doubao_api_key
# DOUBAO_MODEL_ID=your_model_or_endpoint_id
# DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3


