from sentence_transformers import SentenceTransformer
import numpy as np


# 1. 中文知识库，至少8条
documents = [
    "RAG是一种结合检索和生成的大模型应用技术。",
    "Embedding可以把文本转换成向量表示。",
    "向量数据库可以存储和检索Embedding向量。",
    "大语言模型可以根据上下文生成自然语言回答。",
    "机器学习可以让计算机从数据中学习规律。",
    "深度学习是机器学习的一个重要分支。",
    "Prompt Engineering用于设计和优化大模型提示词。",
    "语义搜索根据文本含义而不是关键词进行检索。",
    "Transformer是目前大语言模型常用的神经网络架构。",
    "天气预报可以预测未来几天的天气情况。",
    "生熟食物要分开存放和加工，避免交叉污染。",
    "不吃过期、变质、有异味的食品。",
    "蔬菜水果食用前要充分清洗，去除残留污物。",
    "肉类蛋类要彻底煮熟，不食用半生的肉制品。",
    "饭前便后洗手，养成良好饮食卫生习惯。"
]


# 2. 加载Embedding模型
model = SentenceTransformer(
    "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
    device="cpu"
)


# 3. 程序启动时，对所有知识库文本只做一次Embedding
print("documents数量：", len(documents))
document_embeddings = model.encode(documents)
print("Embedding shape：", document_embeddings.shape)

# 4. 自己实现余弦相似度
def cosine_similarity(a, b):
    return np.dot(a, b) / (
        np.linalg.norm(a) * np.linalg.norm(b)
    )


# 5. Semantic Search
def search(query, top_k=3):

    # Query使用同一个Embedding模型编码
    query_embedding = model.encode(query)

    results = []

    # Query与所有Document逐个计算相似度
    for i in range(len(documents)):

        score = cosine_similarity(
            query_embedding,
            document_embeddings[i]
        )

        results.append(
            (score, documents[i])
        )

    # 按相似度从高到低排序
    results.sort(
        key=lambda x: x[0],
        reverse=True
    )

    # 返回前K个结果
    return results[:top_k]


# 6. 测试查询
query = "神经网络怎么学习"

results = search(query, top_k=3)


# 7. 打印结果
print(f"Query：{query}\n")

for rank, (score, text) in enumerate(results, start=1):
    print(f"Rank：{rank}")
    print(f"Score：{score:.4f}")
    print(f"Text：{text}")
    print()
